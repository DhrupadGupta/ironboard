  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
